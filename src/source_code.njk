        <!-- Helsinki -->
        <circle cx="468" cy="58" r="4" fill="#00ff64" filter="url(#mapglow)"/>
        <text x="473" y="53" fill="#00ff64" font-family="Share Tech Mono,monospace" font-size="7.5" opacity="0.9">HELSINKI</text>

        <!-- Hong Kong -->
        <circle cx="740" cy="185" r="4" fill="#00ff64" filter="url(#mapglow)"/>
        <text x="745" y="180" fill="#00ff64" font-family="Share Tech Mono,monospace" font-size="7.5" opacity="0.9">HONG KONG</text>

        <!-- Sydney — ALERT -->
        <circle cx="790" cy="370" r="4.5" fill="#ff2244" filter="url(#mapglow)"/>
        <text x="795" y="365" fill="#ff2244" font-family="Share Tech Mono,monospace" font-size="7.5" opacity="0.95">SYDNEY !</text>

        <!-- Brazil -->
        <circle cx="195" cy="335" r="4" fill="#00ff64" filter="url(#mapglow)"/>
        <text x="200" y="330" fill="#00ff64" font-family="Share Tech Mono,monospace" font-size="7.5" opacity="0.9">BRAZIL</text>
      </g>

      <defs>
        <filter id="mapglow">
          <feGaussianBlur stdDeviation="3" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
    </svg>
  </div>
</div>

<!-- NODE CARDS -->
<div class="nodes-section">
  <div class="nodes-header">REGISTERED NODES</div>
  <div class="nodes-grid" id="nodeGrid"></div>
</div>

<footer>
  &copy; 10W NETWORK SYSTEMS — ALL ACTIVITY MONITORED AND LOGGED — NODE REF: <span id="nodeRef"></span>
</footer>

<script>
  // Clock
  function tick() {
    const now = new Date();
    document.getElementById('clock').textContent =
      now.toUTCString().slice(17,25) + ' UTC';
  }
  tick();
  setInterval(tick, 1000);

  // Random node ref
  document.getElementById('nodeRef').textContent =
    Math.random().toString(36).slice(2,10).toUpperCase();

  // Node data
  const nodes = [
    { domain: '10w.dev',    loc: 'LOS ANGELES, USA',    up: '99.94%', lat: '9ms',   status: 'green' },
    { domain: '10w.us',   loc: 'NEW YORK, USA',        up: '99.98%', lat: '7ms',   status: 'green' },
    { domain: '10w.uk',   loc: 'LONDON, UK',           up: '99.97%', lat: '8ms',   status: 'green' },
    { domain: '10w.fi',    loc: 'HELSINKI, FI',         up: '100%',   lat: '5ms',   status: 'green' },
    { domain: '10w.wtf',   loc: 'HONG KONG',            up: '99.81%', lat: '22ms',  status: 'green' },
    { domain: '10w.au',    loc: 'SYDNEY, AU',           up: '91.22%', lat: '112ms', status: 'red'   },
    { domain: '10w.email',   loc: 'SÃO PAULO, BR',        up: '99.55%', lat: '33ms',  status: 'green' },
  ];

  const grid = document.getElementById('nodeGrid');
  nodes.forEach(n => {
    const card = document.createElement('div');
    card.className = 'node-card';
    card.innerHTML = `
      <div class="node-domain">${n.domain}</div>
      <div class="node-location">// ${n.loc}</div>
      <div class="node-stats">
        <div class="node-status"><span class="dot ${n.status}"></span>${n.status.toUpperCase()}</div>
        <div class="node-uptime">UP ${n.up}</div>
        <div class="node-uptime">LAT ${n.lat}</div>
      </div>
    `;
    grid.appendChild(card);
  });

  // Subtle random packet counter updates in ticker
  const items = document.querySelectorAll('.ticker-item');
  setInterval(() => {
    const rate = (Math.random() * 0.4 + 1.2).toFixed(1);
    items.forEach(el => {
      if (el.textContent.startsWith('PACKETS')) {
        el.textContent = `PACKETS ROUTED: ${rate}M/sec`;
      }
    });
  }, 2000);
</script>
</body>
</html>
