<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>10W — GLOBAL NODE NETWORK</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #020408;
    --grid: rgba(0,255,100,0.04);
    --green: #00ff64;
    --green-dim: #00aa44;
    --green-dark: #003318;
    --red: #ff2244;
    --amber: #ffaa00;
    --text: #b0ffcc;
    --muted: #2a5a3a;
  }

  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    min-height: 100vh;
    overflow-x: hidden;
    cursor: crosshair;
  }

  /* Scanline overlay */
  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background: repeating-linear-gradient(
      0deg,
      transparent,
      transparent 2px,
      rgba(0,0,0,0.15) 2px,
      rgba(0,0,0,0.15) 4px
    );
    pointer-events: none;
    z-index: 9999;
  }

  /* Grid background */
  body::after {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(var(--grid) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  header {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 40px;
    border-bottom: 1px solid var(--muted);
    background: rgba(2,4,8,0.9);
    backdrop-filter: blur(4px);
  }

  .logo-wrap {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .logo-svg {
    width: 110px;
    height: 110px;
    filter: drop-shadow(0 0 14px var(--green));
  }

  .logo-text {
    font-family: 'Orbitron', sans-serif;
    font-weight: 900;
    font-size: 1.6rem;
    letter-spacing: 0.15em;
    color: var(--green);
    text-shadow: 0 0 20px var(--green), 0 0 40px rgba(0,255,100,0.3);
  }

  .logo-sub {
    font-size: 0.55rem;
    letter-spacing: 0.4em;
    color: var(--green-dim);
    margin-top: 2px;
  }

  .status-bar {
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 0.7rem;
    color: var(--green-dim);
    letter-spacing: 0.1em;
  }

  .status-bar .pulse-dot {
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--green);
    border-radius: 50%;
    margin-right: 6px;
    animation: blink 1.2s ease-in-out infinite;
    box-shadow: 0 0 8px var(--green);
  }

  .status-bar .red { color: var(--red); }
  .status-bar .red .pulse-dot { background: var(--red); box-shadow: 0 0 8px var(--red); }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.2; }
  }

  /* HERO */
  .hero {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 50px 20px 20px;
  }

  .hero-label {
    font-size: 0.65rem;
    letter-spacing: 0.5em;
    color: var(--green-dim);
    margin-bottom: 12px;
    animation: fadeIn 1s ease 0.3s both;
  }

  .hero h1 {
    font-family: 'Orbitron', sans-serif;
    font-size: clamp(1.5rem, 5vw, 3.5rem);
    font-weight: 900;
    color: var(--green);
    text-shadow: 0 0 30px var(--green), 0 0 60px rgba(0,255,100,0.4);
    letter-spacing: 0.08em;
    animation: fadeIn 1s ease 0.5s both;
    line-height: 1.1;
  }

  .hero h1 span {
    color: var(--red);
    text-shadow: 0 0 20px var(--red);
  }

  .hero-desc {
    margin-top: 18px;
    font-size: 0.75rem;
    color: var(--green-dim);
    letter-spacing: 0.15em;
    animation: fadeIn 1s ease 0.8s both;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
    line-height: 1.8;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* WORLD MAP SECTION */
  .map-section {
    position: relative;
    z-index: 5;
    margin: 30px auto;
    max-width: 1000px;
    padding: 0 20px;
  }

  .map-container {
    position: relative;
    border: 1px solid var(--muted);
    background: rgba(0,20,8,0.6);
    box-shadow: 0 0 40px rgba(0,255,100,0.05), inset 0 0 80px rgba(0,0,0,0.5);
    overflow: hidden;
  }

  .map-container::before {
    content: 'GLOBAL NODE MAP // LIVE FEED';
    position: absolute;
    top: 10px;
    left: 14px;
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    color: var(--muted);
    z-index: 20;
  }

  .map-container::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.6) 100%);
    pointer-events: none;
    z-index: 15;
  }

  #worldMap {
    width: 100%;
    display: block;
  }

  /* NODE GRID */
  .nodes-section {
    position: relative;
    z-index: 5;
    max-width: 1000px;
    margin: 0 auto 40px;
    padding: 0 20px;
  }

  .nodes-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    font-size: 0.65rem;
    letter-spacing: 0.35em;
    color: var(--muted);
  }

  .nodes-header::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--muted);
  }

  .nodes-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1px;
    background: var(--muted);
    border: 1px solid var(--muted);
  }

  .node-card {
    background: rgba(2,4,8,0.95);
    padding: 14px 16px;
    transition: background 0.2s;
    position: relative;
    overflow: hidden;
  }

  .node-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    background: var(--green);
    opacity: 0;
    transition: opacity 0.2s;
    box-shadow: 0 0 8px var(--green);
  }

  .node-card:hover {
    background: rgba(0,30,12,0.95);
  }

  .node-card:hover::before { opacity: 1; }

  .node-domain {
    font-family: 'Orbitron', sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--green);
    letter-spacing: 0.1em;
    margin-bottom: 6px;
  }

  .node-location {
    font-size: 0.6rem;
    color: var(--muted);
    letter-spacing: 0.1em;
    margin-bottom: 8px;
  }

  .node-stats {
    display: flex;
    gap: 12px;
    font-size: 0.58rem;
    color: var(--green-dim);
  }

  .node-status {
    display: flex;
    align-items: center;
    gap: 5px;
  }

  .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--green);
    animation: blink 1.5s ease-in-out infinite;
    box-shadow: 0 0 4px var(--green);
  }

  .dot.amber { background: var(--amber); box-shadow: 0 0 4px var(--amber); animation-delay: 0.4s; }
  .dot.red { background: var(--red); box-shadow: 0 0 4px var(--red); animation-delay: 0.7s; }

  .node-uptime {
    color: var(--green-dim);
  }

  /* TICKER */
  .ticker {
    position: relative;
    z-index: 5;
    background: rgba(0,15,5,0.9);
    border-top: 1px solid var(--muted);
    border-bottom: 1px solid var(--muted);
    overflow: hidden;
    height: 30px;
    display: flex;
    align-items: center;
    margin-bottom: 30px;
  }

  .ticker-label {
    flex-shrink: 0;
    padding: 0 14px;
    font-size: 0.58rem;
    letter-spacing: 0.3em;
    color: var(--bg);
    background: var(--green);
    height: 100%;
    display: flex;
    align-items: center;
    font-weight: bold;
  }

  .ticker-track {
    display: flex;
    gap: 60px;
    animation: ticker 30s linear infinite;
    white-space: nowrap;
    font-size: 0.62rem;
    color: var(--green-dim);
    letter-spacing: 0.1em;
    padding-left: 30px;
  }

  @keyframes ticker {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }

  .ticker-item { flex-shrink: 0; }
  .ticker-item .hi { color: var(--green); }
  .ticker-item .lo { color: var(--red); }

  /* FOOTER */
  footer {
    position: relative;
    z-index: 5;
    text-align: center;
    padding: 20px;
    font-size: 0.58rem;
    color: var(--muted);
    letter-spacing: 0.2em;
    border-top: 1px solid var(--muted);
  }

  /* GLITCH animation on logo */
  @keyframes glitch {
    0%, 95%, 100% { clip-path: none; transform: none; }
    96% { clip-path: polygon(0 20%, 100% 20%, 100% 40%, 0 40%); transform: translateX(-4px); }
    97% { clip-path: polygon(0 60%, 100% 60%, 100% 80%, 0 80%); transform: translateX(4px); }
    98% { clip-path: polygon(0 0, 100% 0, 100% 20%, 0 20%); transform: translateX(-2px); }
    99% { clip-path: none; transform: translateX(2px); }
  }

  .logo-text {
    animation: glitch 8s ease-in-out infinite;
  }

  /* Vignette flicker */
  @keyframes flicker {
    0%, 97%, 100% { opacity: 1; }
    98% { opacity: 0.92; }
    99% { opacity: 0.97; }
  }

  body { animation: flicker 10s ease-in-out infinite; }
</style>
</head>
<body>

<header>
  <div class="logo-wrap">
    <!-- SVG LOGO -->
    <svg class="logo-svg" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="glow">
          <feGaussianBlur stdDeviation="2.5" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="glow2">
          <feGaussianBlur stdDeviation="4" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <!-- Outer ring -->
      <circle cx="50" cy="50" r="46" stroke="#00ff64" stroke-width="1" opacity="0.3"/>
      <circle cx="50" cy="50" r="40" stroke="#00ff64" stroke-width="0.5" opacity="0.2" stroke-dasharray="4 6"/>
      <!-- Globe-like lines -->
      <ellipse cx="50" cy="50" rx="28" ry="46" stroke="#00ff64" stroke-width="0.8" opacity="0.4" filter="url(#glow)"/>
      <ellipse cx="50" cy="50" rx="46" ry="18" stroke="#00ff64" stroke-width="0.8" opacity="0.4" filter="url(#glow)"/>
      <line x1="4" y1="50" x2="96" y2="50" stroke="#00ff64" stroke-width="0.8" opacity="0.3"/>
      <line x1="50" y1="4" x2="50" y2="96" stroke="#00ff64" stroke-width="0.8" opacity="0.3"/>
      <!-- Node dots -->
      <circle cx="50" cy="50" r="4" fill="#00ff64" filter="url(#glow2)"/>
      <circle cx="22" cy="38" r="2.5" fill="#00ff64" opacity="0.9" filter="url(#glow)"/>
      <circle cx="74" cy="34" r="2" fill="#00ff64" opacity="0.8" filter="url(#glow)"/>
      <circle cx="68" cy="67" r="2.5" fill="#ff2244" opacity="0.9" filter="url(#glow)"/>
      <circle cx="32" cy="66" r="2" fill="#00ff64" opacity="0.7" filter="url(#glow)"/>
      <!-- Connection lines -->
      <line x1="50" y1="50" x2="22" y2="38" stroke="#00ff64" stroke-width="0.6" opacity="0.5"/>
      <line x1="50" y1="50" x2="74" y2="34" stroke="#00ff64" stroke-width="0.6" opacity="0.5"/>
      <line x1="50" y1="50" x2="68" y2="67" stroke="#ff2244" stroke-width="0.6" opacity="0.5"/>
      <line x1="50" y1="50" x2="32" y2="66" stroke="#00ff64" stroke-width="0.6" opacity="0.4"/>
      <line x1="22" y1="38" x2="74" y2="34" stroke="#00ff64" stroke-width="0.4" opacity="0.3"/>
      <!-- 10W text in center -->
      <text x="50" y="55" text-anchor="middle" font-family="'Orbitron',monospace" font-size="11" font-weight="900" fill="#00ff64" filter="url(#glow2)" opacity="0.9">10W</text>
    </svg>
    <div>
      <div class="logo-text">10W NETWORK</div>
      <div class="logo-sub">DISTRIBUTED INTELLIGENCE GRID</div>
    </div>
  </div>
  <div class="status-bar">
    <span><span class="pulse-dot"></span>NODES ONLINE: <strong style="color:var(--green)">247</strong></span>
    <span class="red"><span class="pulse-dot"></span>ALERTS: <strong>3</strong></span>
    <span id="clock">--:--:--</span>
  </div>
</header>

<div class="ticker">
  <div class="ticker-label">// LIVE //</div>
  <div class="ticker-track" id="ticker">
    <span class="ticker-item">10w.io <span class="hi">↑ NOMINAL</span></span>
    <span class="ticker-item">10w.net <span class="hi">↑ ACTIVE</span></span>
    <span class="ticker-item">10w.org <span class="hi">↑ SYNCED</span></span>
    <span class="ticker-item">10w.co <span class="lo">↓ DEGRADED</span></span>
    <span class="ticker-item">10w.dev <span class="hi">↑ NOMINAL</span></span>
    <span class="ticker-item">PACKETS ROUTED: 1.4M/sec</span>
    <span class="ticker-item">UPTIME: 847 DAYS</span>
    <span class="ticker-item">ENCRYPTION: AES-256-GCM</span>
    <span class="ticker-item">INTRUSION ATTEMPTS BLOCKED: 4,492</span>
    <span class="ticker-item">10w.io <span class="hi">↑ NOMINAL</span></span>
    <span class="ticker-item">10w.net <span class="hi">↑ ACTIVE</span></span>
    <span class="ticker-item">10w.org <span class="hi">↑ SYNCED</span></span>
    <span class="ticker-item">10w.co <span class="lo">↓ DEGRADED</span></span>
    <span class="ticker-item">10w.dev <span class="hi">↑ NOMINAL</span></span>
    <span class="ticker-item">PACKETS ROUTED: 1.4M/sec</span>
    <span class="ticker-item">UPTIME: 847 DAYS</span>
    <span class="ticker-item">ENCRYPTION: AES-256-GCM</span>
    <span class="ticker-item">INTRUSION ATTEMPTS BLOCKED: 4,492</span>
  </div>
</div>

<div class="hero">
  <div class="hero-label">// CLASSIFIED — AUTHORIZED ACCESS ONLY //</div>
  <h1>THE 10W <span>GRID</span><br>IS EVERYWHERE</h1>
  <p class="hero-desc">
    247 NODES. 5 CONTINENTS. ONE NETWORK.<br>
    YOU ARE ALREADY CONNECTED.
  </p>
</div>

<!-- WORLD MAP -->
<div class="map-section">
  <div class="map-container">
    <svg id="worldMap" viewBox="0 0 960 500" xmlns="http://www.w3.org/2000/svg">
      <!-- Simple stylized world map paths -->
      <g fill="rgba(0,40,15,0.5)" stroke="#00aa44" stroke-width="0.5" opacity="0.7">
        <!-- North America -->
        <path d="M80,80 L180,60 L220,80 L240,120 L230,160 L200,180 L170,200 L140,220 L120,260 L100,280 L80,260 L60,220 L50,180 L60,140 Z"/>
        <!-- Greenland -->
        <path d="M240,30 L290,20 L310,50 L290,80 L250,70 Z"/>
        <!-- South America -->
        <path d="M160,280 L200,270 L230,300 L240,350 L220,400 L190,430 L160,420 L140,380 L130,330 L140,300 Z"/>
        <!-- Europe -->
        <path d="M420,60 L470,50 L500,70 L510,100 L490,120 L460,130 L430,120 L410,100 Z"/>
        <!-- Africa -->
        <path d="M430,140 L490,130 L520,160 L530,220 L520,300 L490,360 L460,370 L430,340 L410,280 L400,200 L410,160 Z"/>
        <!-- Russia / Asia -->
        <path d="M500,40 L650,20 L750,40 L780,80 L760,120 L700,140 L640,130 L580,100 L520,80 Z"/>
        <!-- Middle East / India -->
        <path d="M510,120 L580,110 L610,150 L620,200 L590,230 L550,220 L520,190 L500,150 Z"/>
        <!-- SE Asia / China -->
        <path d="M620,80 L750,70 L800,100 L810,150 L780,180 L720,170 L660,150 L630,120 Z"/>
        <!-- Australia -->
        <path d="M700,300 L790,280 L830,310 L840,370 L810,410 L750,420 L700,390 L670,350 Z"/>
        <!-- Japan -->
        <path d="M790,100 L820,90 L830,120 L810,140 L790,130 Z"/>
        <!-- UK -->
        <path d="M408,68 L420,62 L425,80 L410,85 Z"/>
        <!-- Scandinavia -->
        <path d="M440,30 L470,20 L480,50 L460,60 L440,50 Z"/>
      </g>

      <!-- Connection lines between nodes: full mesh -->
      <!-- LA=130,175  NY=165,155  London=415,82  Helsinki=468,58  HongKong=740,185  Sydney=790,370  Brazil=195,335 -->
      <g stroke="#00ff64" stroke-width="0.8" opacity="0.22" fill="none" stroke-dasharray="4 5">
        <!-- LA — NY -->
        <line x1="130" y1="175" x2="165" y2="155"/>
        <!-- NY — London -->
        <line x1="165" y1="155" x2="415" y2="82"/>
        <!-- NY — Helsinki -->
        <line x1="165" y1="155" x2="468" y2="58"/>
        <!-- London — Helsinki -->
        <line x1="415" y1="82" x2="468" y2="58"/>
        <!-- London — Hong Kong -->
        <line x1="415" y1="82" x2="740" y2="185"/>
        <!-- Helsinki — Hong Kong -->
        <line x1="468" y1="58" x2="740" y2="185"/>
        <!-- Hong Kong — Sydney -->
        <line x1="740" y1="185" x2="790" y2="370"/>
        <!-- LA — Brazil -->
        <line x1="130" y1="175" x2="195" y2="335"/>
        <!-- NY — Brazil -->
        <line x1="165" y1="155" x2="195" y2="335"/>
        <!-- London — Brazil -->
        <line x1="415" y1="82" x2="195" y2="335"/>
        <!-- Brazil — Sydney (red — long haul alert) -->
        <line x1="195" y1="335" x2="790" y2="370" stroke="#ff2244" opacity="0.18"/>
      </g>

      <!-- Pulse rings -->
      <g fill="none">
        <!-- Los Angeles -->
        <circle cx="130" cy="175" r="8" stroke="#00ff64" stroke-width="0.6">
          <animate attributeName="r" values="6;18;6" dur="3.1s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.5;0;0.5" dur="3.1s" repeatCount="indefinite"/>
        </circle>
        <!-- New York -->
        <circle cx="165" cy="155" r="8" stroke="#00ff64" stroke-width="0.6">
          <animate attributeName="r" values="6;18;6" dur="2.7s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.5;0;0.5" dur="2.7s" repeatCount="indefinite"/>
        </circle>
        <!-- London -->
        <circle cx="415" cy="82" r="8" stroke="#00ff64" stroke-width="0.6">
          <animate attributeName="r" values="6;18;6" dur="3.4s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.5;0;0.5" dur="3.4s" repeatCount="indefinite"/>
        </circle>
        <!-- Helsinki -->
        <circle cx="468" cy="58" r="8" stroke="#00ff64" stroke-width="0.6">
          <animate attributeName="r" values="6;18;6" dur="4.0s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.5;0;0.5" dur="4.0s" repeatCount="indefinite"/>
        </circle>
        <!-- Hong Kong -->
        <circle cx="740" cy="185" r="8" stroke="#00ff64" stroke-width="0.6">
          <animate attributeName="r" values="6;18;6" dur="2.9s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.5;0;0.5" dur="2.9s" repeatCount="indefinite"/>
        </circle>
        <!-- Sydney — RED alert -->
        <circle cx="790" cy="370" r="8" stroke="#ff2244" stroke-width="0.6">
          <animate attributeName="r" values="6;22;6" dur="2.0s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.7;0;0.7" dur="2.0s" repeatCount="indefinite"/>
        </circle>
        <!-- Brazil -->
        <circle cx="195" cy="335" r="8" stroke="#00ff64" stroke-width="0.6">
          <animate attributeName="r" values="6;18;6" dur="3.6s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.5;0;0.5" dur="3.6s" repeatCount="indefinite"/>
        </circle>
      </g>

      <!-- Node dots & labels -->
      <g>
        <!-- Los Angeles -->
        <circle cx="130" cy="175" r="4" fill="#00ff64" filter="url(#mapglow)"/>
        <text x="104" y="170" fill="#00ff64" font-family="Share Tech Mono,monospace" font-size="7.5" opacity="0.9">LOS ANGELES</text>

        <!-- New York -->
        <circle cx="165" cy="155" r="4" fill="#00ff64" filter="url(#mapglow)"/>
        <text x="170" y="150" fill="#00ff64" font-family="Share Tech Mono,monospace" font-size="7.5" opacity="0.9">NEW YORK</text>

        <!-- London -->
        <circle cx="415" cy="82" r="4" fill="#00ff64" filter="url(#mapglow)"/>
