<header class="relative z-10 flex items-center justify-between px-10 py-5 border-b border-[#2a5a3a] bg-opacity-90 backdrop-blur-sm" style="background-color: rgba(2,4,8,0.9);">
  <div class="flex items-center gap-4">
    <!-- SVG LOGO -->
    <svg class="w-28 h-28 drop-shadow-lg" style="filter: drop-shadow(0 0 14px #00ff64);" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <defs>
        <filter id="glow">
          <feGaussianBlur stdDeviation="2.5" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <filter id="glow2">
          <feGaussianBlur stdDeviation="4" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
      </defs>
      <!-- Outer ring -->
      <circle cx="50" cy="50" r="46" stroke="#00ff64" stroke-width="1" opacity="0.3"/>
      <circle cx="50" cy="50" r="40" stroke="#00ff64" stroke-width="0.5" opacity="0.2" stroke-dasharray="4 6"/>
      <!-- Globe-like lines -->
      <ellipse cx="50" cy="50" rx="28" ry="46" stroke="#00ff64" stroke-width="0.8" opacity="0.4" filter="url(#glow)"/>
      <ellipse cx="50" cy="50" rx="46" ry="18" stroke="#00ff64" stroke-width="0.8" opacity="0.4" filter="url(#glow)"/>
      <line x1="4" y1="50" x2="96" y2="50" stroke="#00ff64" stroke-width="0.8" opacity="0.3"/>
      <line x1="50" y1="4" x2="50" y2="96" stroke="#00ff64" stroke-width="0.8" opacity="0.3"/>
      <!-- Node dots -->
      <circle cx="50" cy="50" r="4" fill="#00ff64" filter="url(#glow2)"/>
      <circle cx="22" cy="38" r="2.5" fill="#00ff64" opacity="0.9" filter="url(#glow)"/>
      <circle cx="74" cy="34" r="2" fill="#00ff64" opacity="0.8" filter="url(#glow)"/>
      <circle cx="68" cy="67" r="2.5" fill="#ff2244" opacity="0.9" filter="url(#glow)"/>
      <circle cx="32" cy="66" r="2" fill="#00ff64" opacity="0.7" filter="url(#glow)"/>
      <!-- Connection lines -->
      <line x1="50" y1="50" x2="22" y2="38" stroke="#00ff64" stroke-width="0.6" opacity="0.5"/>
      <line x1="50" y1="50" x2="74" y2="34" stroke="#00ff64" stroke-width="0.6" opacity="0.5"/>
      <line x1="50" y1="50" x2="68" y2="67" stroke="#ff2244" stroke-width="0.6" opacity="0.5"/>
      <line x1="50" y1="50" x2="32" y2="66" stroke="#00ff64" stroke-width="0.6" opacity="0.4"/>
      <line x1="22" y1="38" x2="74" y2="34" stroke="#00ff64" stroke-width="0.4" opacity="0.3"/>
      <!-- 10W text in center -->
      <text x="50" y="55" text-anchor="middle" font-family="'Orbitron',monospace" font-size="11" font-weight="900" fill="#00ff64" filter="url(#glow2)" opacity="0.9">10W</text>
    </svg>
    <div>
      <div class="logo-text font-['Orbitron'] font-black text-2xl tracking-widest text-[#00ff64]" style="text-shadow: 0 0 20px #00ff64, 0 0 40px rgba(0,255,100,0.3);">10W NETWORK</div>
      <div class="text-xs tracking-widest text-[#00aa44] mt-0.5">DISTRIBUTED INTELLIGENCE GRID</div>
    </div>
  </div>
  <div class="flex items-center gap-6 text-xs tracking-wide text-[#00aa44]">
    <span><span class="inline-block w-2 h-2 bg-[#00ff64] rounded-full mr-1.5 pulse-dot" style="box-shadow: 0 0 8px #00ff64;"></span>NODES ONLINE: <strong class="text-[#00ff64]">247</strong></span>
    <span class="text-[#ff2244]"><span class="inline-block w-2 h-2 bg-[#ff2244] rounded-full mr-1.5 pulse-dot" style="box-shadow: 0 0 8px #ff2244;"></span>ALERTS: <strong>3</strong></span>
    <span id="clock" class="text-[#00aa44]">--:--:--</span>
  </div>
</header>