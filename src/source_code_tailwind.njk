    <span>REGISTERED NODES</span>
    <div class="flex-1 h-px bg-[#2a5a3a]"></div>
  </div>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-px bg-[#2a5a3a] border border-[#2a5a3a]" id="nodeGrid"></div>
